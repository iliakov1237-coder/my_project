def calculate_final_price(price: float, discount_percent: float, coupon: str = None) -> tuple:
    if price <= 0:
        raise ValueError("Стоимость товара должна быть больше нуля.")
    if not (0 <= discount_percent <= 100):
        raise ValueError("Скидка должна быть в диапазоне от 0 до 100%.")
    discount_amount = price * (discount_percent / 100)
    final_price = price - discount_amount
    if coupon == "SUMMER2026":
        final_price -= 500
    if final_price < 0:
        final_price = 0
    saved_money = price - final_price
    return round(final_price, 2), round(saved_money, 2)
